# ============================================================
#  Переменные окружения «Архыдея клининг»
#  Скопируйте этот файл в .env и заполните значения.
# ============================================================

# Уведомления в Telegram НАСТРАИВАЮТСЯ НЕ ЗДЕСЬ.
# Токен бота живёт только на сервере CRM (переменные Railway:
# TELEGRAM_BOT_TOKEN и TELEGRAM_CHAT_ID). В браузер он не попадает —
# иначе его прочитал бы любой посетитель сайта.

# CRM «Archidea Sistem» — заявки с сайта уходят сюда автоматически.
# VITE_CRM_API_URL    — базовый URL API NestJS (Railway), напр. https://crm-api.up.railway.app/api
# VITE_CRM_INTAKE_KEY — ключ приёма заявок (= LEADS_INTAKE_API_KEY на бэкенде)
VITE_CRM_API_URL=
VITE_CRM_INTAKE_KEY=
