# PostgreSQL (Railway даст этот URL автоматически)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# JWT — обязательно поменяйте в продакшене на длинный случайный ключ.
# Проверяется только длина (>= 16), поэтому плейсхолдер ниже формально пройдёт —
# не оставляйте его в бою.
JWT_SECRET="change_me_to_a_long_random_string"

PORT=4000

# URL фронтенда CRM (Vercel) и лендинга — для CORS и защиты от CSRF.
# Без них браузерные запросы с Vercel будут отклонены.
FRONTEND_URL="https://your-crm.vercel.app"
LANDING_URL="https://your-landing.vercel.app"

# Ключ, которым лендинг авторизуется при отправке заявки в CRM
LEADS_INTAKE_API_KEY="change_me_to_a_random_key"

# ── Пароли сотрудников ───────────────────────────────────────────────
# Пароли в коде не хранятся. При первом создании сотрудника пароль берётся
# из SEED_PW_<ЛОГИН>. Если переменной нет — пароль будет случайным и никуда
# не выведется, то есть войти под этим сотрудником не получится.
SEED_PW_ANISA=""
SEED_PW_ADMIN=""
SEED_PW_MUNIM=""
SEED_PW_MUSLIM=""
SEED_PW_UBAYDULLO=""
SEED_PW_FARIZA=""
SEED_PW_IRODA=""
# Запасной вариант: один пароль для всех, у кого нет своего SEED_PW_<ЛОГИН>
# SEED_DEFAULT_PASSWORD=""

# РАЗОВЫЙ флаг. Пока включён, при каждом старте пароли уже существующих
# сотрудников перезаписываются значениями из SEED_PW_<ЛОГИН>, снимается
# блокировка после неудачных попыток и сбрасываются все активные сессии.
# Нужен, когда сотрудники были созданы раньше, чем появились переменные.
# ОБЯЗАТЕЛЬНО снимите его после проверки входа — иначе смена пароля внутри
# CRM будет откатываться при каждом рестарте.
# SEED_RESET_PASSWORDS=true
