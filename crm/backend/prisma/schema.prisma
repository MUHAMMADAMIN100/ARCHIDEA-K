// ============================================================
//  Archidea Sistem — схема базы данных (PostgreSQL)
// ============================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── ENUMS ─────────────────────────

/// Роли доступа. Клинеры в CRM не заходят — это не User.
enum Role {
  DIRECTOR // Руководитель — полный доступ
  SUPERVISOR // Управляющий — вся работа компании, кроме денег и доступов
  MANAGER // Менеджер — только свои данные и своя команда
}

/// Источник обращения клиента
enum LeadSource {
  SITE // сайт (автоматическая заявка)
  INSTAGRAM
  CALL // звонок
  COLD_CALL // холодный обзвон — менеджер позвонил первым
  RECOMMENDATION
  ANISA // «От Анисы» — клиенты, пришедшие лично от руководителя
}

/// Каким вышел разговор с клиентом — по нему считают работу менеджеров
enum CallType {
  COLD // холодный: не заинтересован
  NEUTRAL // нейтральный: слушает, но не решил
  HOT // горячий: готов заказывать
}

/// Этапы воронки продаж (5.2)
enum FunnelStage {
  NEW // 1. Новая заявка
  PROCESSING // 2. Обработка
  INSPECTION // 3. Осмотр объекта
  OFFER // 4. Коммерческое предложение
  CONFIRMED // 5. Подтверждён
  IN_PROGRESS // 6. В работе
  DONE // 7. Выполнено
  PAID // 8. Оплачено / Закрыто
  REJECTED // 9. Отказ
}

/// Тип уборки (совпадает с калькулятором лендинга)
enum CleaningType {
  MAINTENANCE // Поддерживающая (архив — услуга закрыта, значение хранится для старых заказов)
  GENERAL // Генеральная
  POST_RENOVATION // После ремонта
  FURNITURE // Мойка мягкой мебели (цена за посадочное место)
}

/// Степень загрязнения — определяет цену за м²
enum DirtLevel {
  LIGHT // лёгкая
  MEDIUM // средняя
  HEAVY // тяжёлая
}

/// Как клинер попадёт на объект
enum AccessMethod {
  KEYS // передать ключи
  ONSITE // буду на месте
}

/// Теги клиента
enum ClientTag {
  VIP
  REGULAR // постоянный клиент
  REFUSED // отказник
  POTENTIAL // потенциальный
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT // срочно — выше «высокого», задача идёт первой в списке
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

/// Тип задачи в календаре (цвет карточки и фильтр «Тип»)
enum TaskType {
  CALL // звонок
  INSPECTION // осмотр объекта
  VISIT // выезд
  MEETING // встреча
  PERSONAL // личное
}

enum NotificationType {
  NEW_LEAD // новая заявка с сайта (менеджеру)
  NEW_TASK // новая задача от руководителя (менеджеру)
  TASK_STATUS_CHANGED // исполнитель сменил статус задачи (постановщику)
  ORDER_STATUS_CHANGED // смена статуса крупного заказа (руководителю)
  REPORT_SENT // менеджер отправил платёжную ведомость (руководителю)
  ORDER_PREFERENCES // заказ с учётом предпочтений клиента (ТЗ 10.2)
  REMINDER_DUE // пора перезвонить клиенту (ТЗ 10.1)
  REMINDER_ASSIGNED // руководитель поставил напоминание на сотрудника
  PROPOSAL_SENT // коммерческое предложение отправлено (ТЗ 9.2)
  CHECKLIST_DONE // чек-лист по заказу закрыт (ТЗ 8)
  SHIFT_CLOSED // смена закрыта (ТЗ 4)
  VISIT_PLANNED // выезд на осмотр создан автоматически из заказа
  BONUS_ACCRUED // начислена премия (ТЗ 7.2)
  REPORT_DRAFT_READY // по оплаченному заказу подготовлен черновик ведомости
}

/// Действие в журнале изменений (ТЗ 2)
enum AuditAction {
  CREATE
  UPDATE
  DELETE // перенос в корзину
  RESTORE // возврат из корзины
  PURGE // безвозвратное удаление
  STAGE_CHANGE // смена этапа воронки
}

/// Состояние выезда бригады на объект (ТЗ 4)
enum ShiftGroupStatus {
  PLANNED // запланирован
  IN_PROGRESS // в работе
  CLOSED // закрыт, данные заархивированы
}

/// Тип финансовой записи (ТЗ 7.1)
enum FinanceKind {
  INCOME // доход
  EXPENSE // расход
}

/// Как появилась финансовая запись
enum FinanceSource {
  AUTO // создана системой (оплаченный заказ, принятая ведомость, премия)
  MANUAL // внесена вручную
}

/// Чем заплатил клиент (ТЗ 3.1). Конкретный банк хранится отдельно —
/// справочником PaymentBank, чтобы новый банк заводился без правки кода.
enum PaymentMethod {
  CASH // наличные
  BANK // безналичный расчёт / перевод
}

/// Статья доходов и расходов (ТЗ 7.1)
enum FinanceCategory {
  ORDER_PAYMENT // оплата заказа
  OTHER_INCOME // прочий доход
  SALARY // выплаты сотрудникам
  BONUS // премии
  SUPPLIES // расходные материалы и инвентарь
  TRANSPORT // транспорт
  RENT // аренда
  UTILITIES // коммунальные услуги — свет, вода, интернет
  MARKETING // реклама и продвижение
  BARTER // бартер — расчёт услугами вместо денег
  TAX // налоги и сборы
  OTHER_EXPENSE // прочий расход
}

/// Состояние чек-листа по заказу (ТЗ 8)
enum ChecklistStatus {
  OPEN
  IN_PROGRESS
  DONE
}

/// Состояние коммерческого предложения (ТЗ 9)
enum ProposalStatus {
  DRAFT // черновик
  SENT // отправлено клиенту
  ACCEPTED // принято
  REJECTED // отклонено
}

/// Состояние напоминания о звонке (ТЗ 10.1)
enum ReminderStatus {
  PENDING // ждёт своего часа
  SENT // уведомление отправлено
  DONE // менеджер отметил, что позвонил
  CANCELLED // отменено
}

/// Откуда взялось напоминание
enum ReminderSource {
  MANUAL // поставлено вручную
  PREORDER // предзаказ («перезвонить через N времени»)
}

/// Состояние сообщения в очереди Telegram
enum TelegramStatus {
  PENDING // ждёт отправки
  SENDING // отправляется
  SENT // доставлено
  FAILED // исчерпаны попытки
}

/// Статус платёжной ведомости (отчёта по объекту)
enum ReportStatus {
  DRAFT // черновик
  SENT // отправлен основателю
  ACCEPTED // принят основателем (смены/штрафы разнесены в выплаты)
}

// ───────────────────────── MODELS ─────────────────────────

/// Пользователь системы (Руководитель или Менеджер)
model User {
  id             String   @id @default(cuid())
  login          String   @unique
  passwordHash   String
  fullName       String
  role           Role     @default(MANAGER)
  phone          String?
  position       String? // должность («Операционный управляющий», «Логист»…)
  duties         String? // должностные обязанности (список, по строке на пункт)
  mainTask       String? // основная задача сотрудника
  acceptsLeads   Boolean  @default(true) // участвует в авто-распределении заявок с сайта
  /// Владелец компании: единственный, кто может удалять сотрудников
  isOwner        Boolean  @default(false)
  canManageOps   Boolean  @default(false) // расширенный доступ: как директор, но без финансов
  /// ТЗ 1.2 — полный доступ к модулю задач: видит, создаёт, назначает и правит
  /// ВСЕ задачи компании, а не только свои (у Ироды)
  canManageTasks Boolean  @default(false)
  /// Доступ к корзине — персональное право, а НЕ следствие роли.
  /// Руководителей несколько, а разбирать удалённое доверено не всем.
  canSeeTrash    Boolean  @default(false)
  /// Персональный запрет на финансы — СИЛЬНЕЕ роли.
  /// Руководителей в компании несколько, но деньги компании владелец
  /// открывает не каждому: этот сотрудник сохраняет управление людьми и
  /// операциями, но не видит доходов, расходов, выплат, премий и выручки.
  noFinance      Boolean  @default(false)
  /// Персональный доступ к платёжным ведомостям — СИЛЬНЕЕ запрета на финансы.
  /// Ведомости ведут и сводят те, кому доверено, даже если книга доходов и
  /// расходов компании им закрыта: это разные вещи.
  canSeeReports  Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ── Уведомления в Telegram (ТЗ 10) ──
  /// Личный chat_id — заполняется сам, когда сотрудник жмёт «Старт» у бота
  telegramChatId      String?
  telegramEnabled     Boolean   @default(true)
  /// Как зовут человека в Telegram — показываем в профиле, чтобы было видно,
  /// к какому именно аккаунту подключён бот
  telegramName        String?
  /// Одноразовый код привязки: кнопка «Подключить Telegram» кладёт его сюда
  /// и даёт ссылку t.me/бот?start=код. Код живёт сутки и сгорает при первом
  /// использовании — по чужой ссылке подключиться нельзя.
  telegramLinkCode    String?   @unique
  telegramLinkExpires DateTime?

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  // ── Безопасность входа ──
  /// Неудачных попыток подряд (сбрасывается при успешном входе)
  failedLogins Int       @default(0)
  /// Аккаунт заблокирован до этого момента (защита от подбора пароля)
  lockedUntil  DateTime?
  /// Версия сессий. Растёт при смене пароля и «выйти со всех устройств» —
  /// все ранее выданные токены с меньшей версией перестают действовать.
  sessionEpoch Int       @default(0)

  // связи
  clients         Client[]         @relation("ManagerClients")
  orders          Order[]          @relation("ManagerOrders")
  cleaners        Cleaner[] // клинеры в команде менеджера
  tasksAssigned   Task[]           @relation("TaskAssignee")
  tasksCreated    Task[]           @relation("TaskCreator")
  taskAssignments TaskAssignment[] @relation("TaskAssignments")
  notifications   Notification[]
  reports         Report[]         @relation("ReportManager")

  @@index([deletedAt])
}

/// Клинер — член бригады. НЕ имеет доступа в CRM.
model Cleaner {
  id               String             @id @default(cuid())
  fullName         String
  phone            String?
  rate             Int                @default(230) // ставка, сомони за смену (бригадир — 330)
  duties           String? // обязанности (для бригадиров)
  isActive         Boolean            @default(true)
  manager          User?              @relation(fields: [managerId], references: [id], onDelete: SetNull)
  managerId        String?
  brigade          Brigade?           @relation("BrigadeMembers", fields: [brigadeId], references: [id], onDelete: SetNull)
  brigadeId        String?
  leaderOf         Brigade?           @relation("BrigadeLeader")
  orders           Order[]            @relation("OrderCleaners")
  shifts           Shift[]
  fines            Fine[]
  reportRows       ReportWorker[]
  groupMemberships ShiftGroupMember[] // участие в выездах (ТЗ 4)
  bonuses          Bonus[] // премии (ТЗ 7.2)
  createdAt        DateTime           @default(now())

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([brigadeId])
  @@index([deletedAt])
}

/// Бригада клинеров (у бригады есть бригадир с повышенной ставкой)
model Brigade {
  id        String    @id @default(cuid())
  name      String    @unique
  leader    Cleaner?  @relation("BrigadeLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  leaderId  String?   @unique
  cleaners  Cleaner[] @relation("BrigadeMembers")
  createdAt DateTime  @default(now())
}

/// Смена клинера — ЕДИНИЦА ОПЛАТЫ: один клинер, один оплаченный день.
/// Ограничение @@unique([cleanerId, date]) сохранено намеренно: оно защищает от
/// двойного начисления и на него опирается reports.service (skipDuplicates).
/// Состав и адрес выезда живут в ShiftGroup — выездов за день может быть несколько.
model Shift {
  id        String      @id @default(cuid())
  date      DateTime // день смены (00:00 UTC)
  cleaner   Cleaner     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  cleanerId String
  rate      Int // ставка на момент смены (снапшот — не меняется задним числом)
  note      String? // объект/комментарий
  /// Выезд, который породил эту оплачиваемую смену (ТЗ 4)
  group     ShiftGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId   String?
  createdAt DateTime    @default(now())

  @@unique([cleanerId, date])
  @@index([date])
  @@index([groupId])
}

/// Выезд бригады на объект: адрес, время, состав группы, ответственный менеджер.
/// Отвечает на вопрос ТЗ 4 «куда выезжали, когда и с кем».
model ShiftGroup {
  id        String           @id @default(cuid())
  date      DateTime // календарный день выезда (00:00 UTC)
  address   String // точный адрес объекта — обязателен
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   String?
  startTime String? // «09:30» — местное время Душанбе
  endTime   String?
  status    ShiftGroupStatus @default(PLANNED)

  // бригада и ответственные — снапшот-ссылки: состав может смениться, история нет
  brigadeId     String?
  brigadeName   String?
  brigadierId   String?
  brigadierName String?
  managerId     String?
  managerName   String?

  note String?

  // ── Архив при закрытии смены (ТЗ 4) ──
  closedAt       DateTime?
  closedById     String?
  closedByName   String?
  /// Неизменяемый слепок на момент закрытия: адрес, дата, время, состав, ставки
  closedSnapshot Json?

  members ShiftGroupMember[]
  shifts  Shift[] // оплачиваемые смены, порождённые этим выездом

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([date])
  @@index([orderId])
  @@index([status, date])
  @@index([deletedAt])
}

/// Участник выезда — «кто с кем поехал» (ТЗ 4)
model ShiftGroupMember {
  id        String     @id @default(cuid())
  group     ShiftGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  /// null — разовый клинер (замена): человек не заведён в базе,
  /// есть только имя и выплата за эту смену
  cleaner   Cleaner?   @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  cleanerId String?
  isGuest   Boolean    @default(false)
  fullName  String // снапшот ФИО
  role      String     @default("Клинер") // «Бригадир» / «Клинер» на этом выезде
  rate      Int // снапшот ставки
  createdAt DateTime   @default(now())

  @@unique([groupId, cleanerId])
  @@index([cleanerId])
}

/// Штраф клинеру (сумма + причина, вычитается из выплат)
model Fine {
  id          String   @id @default(cuid())
  cleaner     Cleaner  @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  cleanerId   String
  amount      Int // сомони
  reason      String
  date        DateTime @default(now())
  createdById String? // кто назначил (User.id)
  createdAt   DateTime @default(now())

  @@index([cleanerId, date])
  @@index([date])
}

/// Клиент — ядро базы. Фиксируется КАЖДОЕ обращение.
model Client {
  id           String      @id @default(cuid())
  fullName     String
  phone        String      @unique // защита от дублей по телефону
  /// Запасные номера «на всякий случай» — второй, третий и т.д.
  extraPhones  String[]    @default([])
  /// «От кого» — рекомендатель или партнёр («От Анисы», «От Ибодат»)
  sourceDetail String?
  /// Адрес клиента — спрашивается при заведении и подставляется в новые заказы
  address      String?
  email        String?
  source       LeadSource  @default(SITE)
  tags         ClientTag[] @default([])
  notes        String? // комментарии и заметки менеджера
  /// Постоянная скидка клиента в сомони — подставляется в новые заказы
  discount     Int         @default(0)
  /// ТЗ 10.2 — постоянные предпочтения клиента (без запаха хлорки, есть кот, обувь снимать…)
  preferences  String?

  // ── Холодные звонки ──
  /// Каким вышел последний разговор: холодный, нейтральный, горячий
  callType      CallType?
  /// Когда перезвонить: на этот день и час в календаре встаёт отметка «позвонить»
  callbackAt    DateTime?
  /// Степень заинтересованности: «Перезвоню», «Подумаю», «Посоветуюсь» и свои
  /// варианты. Свободный текст: справочник собирается из уже использованных
  /// значений — так же, как теги клиента.
  interestLevel String?

  lastContactAt DateTime   @default(now())
  manager       User?      @relation("ManagerClients", fields: [managerId], references: [id], onDelete: SetNull)
  managerId     String?
  orders        Order[]
  proposals     Proposal[] // коммерческие предложения (ТЗ 9)
  reminders     Reminder[] // напоминания перезвонить (ТЗ 10.1)
  tasks         Task[] // встречи и звонки, назначенные по этому клиенту

  // ── Повторный клиент (ТЗ 9.4) ──
  /// true со второго ОПЛАЧЕННОГО заказа
  isRepeat        Boolean   @default(false)
  paidOrdersCount Int       @default(0)
  lastOrderAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?
  // @@index([phone]) убран: @unique на phone уже создаёт индекс.
  // @unique СОХРАНЁН намеренно: клиент из корзины с тем же телефоном
  // восстанавливается вместе со своей историей, а не дублируется.

  @@index([managerId])
  @@index([isRepeat])
  @@index([deletedAt])
  // календарь спрашивает перезвоны за месяц — по дате, а не перебором клиентов
  @@index([callbackAt])
}

/// Заказ / обращение — движется по воронке. История заказов клиента.
model Order {
  id        String      @id @default(cuid())
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  manager   User?       @relation("ManagerOrders", fields: [managerId], references: [id], onDelete: SetNull)
  managerId String?
  stage     FunnelStage @default(NEW)
  source    LeadSource  @default(SITE)

  // параметры уборки (из калькулятора / анкеты)
  cleaningType   CleaningType @default(GENERAL)
  /// ТЗ 1.1 — ключ услуги из Tariff.key. Позволяет заводить новые услуги, которых
  /// нет в перечислении CleaningType. Для старых заказов = cleaningType.
  serviceKey     String?
  dirtLevel      DirtLevel? // степень загрязнения (для уборки по м²)
  area           Int          @default(0)
  seats          Int? // посадочные места (для мойки мягкой мебели)
  address        String?
  estimatedPrice Int          @default(0) // расчёт с сайта
  pricePerSqm    Int? // цена за м² (за место для мебели) — из чего сложилась цена
  finalPrice     Int? // итог после осмотра/КП
  /// ТЗ 5 — сумму переписали руками, автоматический пересчёт её не трогает
  isManualPrice  Boolean      @default(false)
  preferences    String? // предпочтения клиента по этому заказу (заполняет менеджер)

  // данные анкеты с сайта
  preferredDate      DateTime?
  preferredTime      String?
  hasUtilities       Boolean?
  accessMethod       AccessMethod?
  comment            String?
  extras             Json? // канал заявок с сайта: ключ услуги → количество
  /// Доп. услуги заказа строками: [{ title, price, checked }].
  ///
  /// Раньше в карточке стоял готовый список из справочника с галочками, и
  /// вписать «вынос мусора — 150» было некуда. Теперь менеджер заводит свои
  /// строки прямо в заказе; в сумму идут только отмеченные. Услуги, пришедшие
  /// с сайта, превращаются в такие же строки при оформлении заказа — чтобы в
  /// карточке было видно, из чего сложилась цена.
  customExtras       Json?
  /// Дополнительные ОСНОВНЫЕ услуги заявки (мульти-выбор): снапшот строк
  /// {key, title, unit, qty, pricePerUnit, total} — история не зависит от
  /// последующих правок справочника
  additionalServices Json?
  /// «От кого» пришла заявка — рекомендатель или партнёр
  sourceDetail       String?
  /// Скидка по заказу в сомони. Вычитается из суммы работ и доп. услуг.
  discount           Int            @default(0)
  /// Разовые сотрудники, привлечённые под этот заказ (ТЗ): массив
  /// {fullName, rate} — кого позвали на один раз и сколько ему отдали.
  /// В штат и в выплаты не попадают: это запись о наличных на руки.
  guestCleaners      Json?
  /// Состав по дням многодневной уборки (решение владельца): [{day, cleanerIds}]
  /// для дней со 2-го. Нет записи — в этот день работает весь состав заказа.
  dayTeams           Json?
  /// Сколько клиент уже заплатил, сомони — сумма всех взносов по заказу.
  /// Поле оставлено денормализованным: по нему считаются долг на карточке,
  /// сумма этапа в воронке и аналитика, и пересчитывается оно сервером при
  /// любом изменении платежей (см. payments.service.ts).
  paidAmount         Int            @default(0)
  /// Взносы по заказу (ТЗ 3.1, 3.2): чем, когда и сколько заплатили
  payments           OrderPayment[]
  /// Разбивка объекта: блоки, этажи, помещения
  segments           OrderSegment[]

  // этапы воронки
  inspectionDate  DateTime? // 3. осмотр
  scheduledDate   DateTime? // 5. подтверждённая дата уборки (первый день)
  /// Последний день уборки, если она идёт не один день (ТЗ: уборка на 2 дня).
  /// Пусто — работа на один день, как было раньше. Клинеру начисляется смена
  /// за КАЖДЫЙ день такого заказа: он работал два дня, значит и платят за два.
  scheduledEndDate DateTime?
  rejectionReason String? // 9. причина отказа
  isLarge         Boolean   @default(false) // крупный заказ (для уведомления руководителю)

  cleaners       Cleaner[]       @relation("OrderCleaners") // назначенная команда
  reports        Report[]
  shiftGroups    ShiftGroup[] // выезды по этому заказу (ТЗ 4)
  checklist      OrderChecklist? // чек-лист качества (ТЗ 8)
  proposals      Proposal[] // коммерческие предложения (ТЗ 9)
  reminders      Reminder[] // напоминания (ТЗ 10.1)
  financeEntries FinanceEntry[] // доходы и расходы по заказу (ТЗ 7.1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  /// Дата закрытия. У закрытой сделки РАВНА дате оформления (createdAt) —
  /// решение владельца, см. OrdersService.closingDateOf. По ней считается
  /// выручка периода, поэтому «когда оформили» и «каким месяцем считаем» —
  /// это одно и то же число.
  closedAt       DateTime?

  /// Когда запись реально появилась в системе.
  ///
  /// Отличается от createdAt тем, что её НЕЛЬЗЯ поменять руками: createdAt —
  /// это «дата оформления заявки», её менеджер правит, внося старые сделки.
  /// В расчётах не участвует: и доска, и папка «Архив», и выручка смотрят на
  /// дату оформления. Хранится как честный след — когда заказ реально завели.
  registeredAt DateTime @default(now())

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([managerId])
  @@index([stage])
  @@index([clientId])
  @@index([stage, closedAt]) // выручка по периодам и подсчёт закрытых
  @@index([serviceKey])
  @@index([deletedAt])
}

/// Задача от руководителя менеджеру
model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        TaskType     @default(MEETING)
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(OPEN) // сводный статус (считается по исполнителям)
  deadline    DateTime?
  // основной исполнитель — оставлен для совместимости; полный список в assignments
  assignee    User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assigneeId  String
  creator     User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId   String
  /// Клиент, к которому относится задача: встречу и звонок назначают по
  /// конкретному человеку, и перед выездом нужны его телефон и адрес.
  /// Необязателен — внутренние задачи клиента не имеют.
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignments TaskAssignment[]

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([assigneeId])
  @@index([deletedAt])
  @@index([clientId])
}

/// Исполнитель задачи со своим статусом (в одной задаче их может быть несколько)
model TaskAssignment {
  id        String     @id @default(cuid())
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  user      User       @relation("TaskAssignments", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    TaskStatus @default(OPEN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([taskId, userId])
  @@index([userId, status])
}

/// Событие расписания менеджера (осмотры, выезды, встречи)
/// Журнал попыток входа — видно, кто и когда заходил и были ли атаки
model LoginAttempt {
  id        String   @id @default(cuid())
  login     String // введённый логин (даже если такого пользователя нет)
  userId    String? // заполняется, если логин существует
  success   Boolean
  reason    String? // причина отказа: BAD_PASSWORD / NO_USER / LOCKED / INACTIVE
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([login, createdAt])
  @@index([createdAt])
}

/// Уведомление внутри CRM (колокольчик)
model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  orderId   String?
  taskId    String?
  /// Клиент, к которому относится уведомление — по клику открывается его карточка
  clientId  String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

/// Платёжная ведомость по объекту (отчёт менеджера основателю)
model Report {
  id     String       @id @default(cuid())
  status ReportStatus @default(DRAFT)

  // объект (снапшоты — отчёт не меняется при правках заказа)
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId       String?
  clientName    String
  clientPhone   String?
  address       String?
  workDate      DateTime? // дата начала работ
  workEndDate   DateTime? // дата завершения (если многодневный объект)
  unitsLabel    String? // «180 м² по 25 с» — площадь/места и цена за единицу
  extraServices String? // доп. услуга и стоимость на единицу (текстом, как на бланке)
  discount      Int       @default(0) // предоставленная скидка
  totalPrice    Int       @default(0) // итоговая стоимость (выручка по объекту)
  arrivedBy     String? // прибыл(а)
  brigadierName String? // ответственный бригадир
  managerName   String? // ответственный менеджер (снапшот)

  /// Restrict, а не Cascade: удаление сотрудника не должно стирать ПРИНЯТЫЕ
  /// платёжные ведомости — по ним уже выплачены деньги (финансовый архив)
  manager      User      @relation("ReportManager", fields: [managerId], references: [id], onDelete: Restrict)
  managerId    String
  sentAt       DateTime?
  acceptedAt   DateTime?
  acceptedById String?

  workers  ReportWorker[]
  expenses ReportExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([managerId, status])
  @@index([status])
  @@index([deletedAt])
}

/// Строка таблицы работников ведомости
model ReportWorker {
  id        String   @id @default(cuid())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String
  cleaner   Cleaner? @relation(fields: [cleanerId], references: [id], onDelete: SetNull)
  cleanerId String?
  fullName  String // снапшот ФИО
  role      String   @default("Клинер") // «Бригадир» / «Клинер»
  days      Int      @default(1) // дней/смен
  rate      Int // ставка за день (снапшот)
  fine      Int      @default(0) // штраф
  extra     Int      @default(0) // доп. услуги (сумма)
  // сумма к выплате = days × rate − fine + extra (вычисляется)

  @@index([reportId])
}

/// Строка «Доп. расходы» ведомости
model ReportExpense {
  id        String  @id @default(cuid())
  report    Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String
  title     String // наименование расхода
  initiator String? // инициатор
  amount    Int // сумма
  comment   String? // комментарий

  @@index([reportId])
}

/// Услуга — цены по степени загрязнения (полное управление директором, ТЗ 1.1).
/// key — строка, а не CleaningType: директор заводит НОВЫЕ услуги, которых нет
/// в перечислении. Для трёх исходных услуг key совпадает со значением CleaningType.
model Tariff {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?
  pricePerSqm Int // legacy: держим = priceMedium (старые клиенты API)
  priceLight  Int      @default(0) // лёгкая степень загрязнения
  priceMedium Int      @default(0) // средняя
  priceHeavy  Int      @default(0) // тяжёлая
  hasLevels   Boolean  @default(true) // false — одна цена (мягкая мебель: за место)
  unit        String   @default("м²") // единица: «м²», «место», «шт»
  /// Базовая услуга: ключ и единицу менять нельзя, удалять нельзя —
  /// на них завязаны лендинг и старые заказы
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  /// Что ВХОДИТ в услугу — построчно. Список нужен не для красоты: спор
  /// «а мыть окна вы должны были?» решается только тем, что записано заранее.
  includedWorks String[] @default([])
  /// Что НЕ входит и оплачивается отдельно
  excludedWorks String[] @default([])

  /// Выработка: сколько единиц (м², мест) успевает один человек за смену.
  /// По ней считается срок работ и нужное число людей (ТЗ: планирование).
  outputPerDay Int?

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

/// Уровень разбивки объекта: блок → этаж → помещение
enum SegmentKind {
  BLOCK // корпус, блок, подъезд
  FLOOR // этаж
  ROOM // помещение
}

/// Часть объекта в заказе: блок, этаж или помещение.
///
/// Большой объект нельзя посчитать одной цифрой площади: бригаде нужно знать,
/// сколько этажей, какие помещения и сколько метров в каждом. Дерево хранится
/// плоским списком со ссылкой на родителя — так его легко переписать целиком
/// одним запросом, не сверяя, что где переставили.
model OrderSegment {
  id       String         @id @default(cuid())
  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String
  parent   OrderSegment?  @relation("SegmentTree", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children OrderSegment[] @relation("SegmentTree")

  kind      SegmentKind
  title     String
  /// Площадь части, м². У блока и этажа обычно пусто — она складывается из помещений
  area      Int?
  /// Что именно делать в этом помещении — если отличается от общего состава работ
  note      String?
  sortOrder Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([parentId])
}

/// Доп. услуга с фиксированной ценой (полное управление директором, ТЗ 1.1)
model ExtraService {
  id        String   @id @default(cuid())
  key       String   @unique // windows / fridge / oven / ironing
  title     String
  price     Int
  hasQty    Boolean  @default(false)
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════
//  ТЗ 2 — Журнал изменений
// ═══════════════════════════════════════════════════════════

/// Кто, когда и что именно изменил. Пишется по всем ключевым сущностям.
/// actorId — снапшот-ссылка без внешнего ключа (как LoginAttempt.userId и
/// Fine.createdById): журнал переживает удаление сотрудника и не мешает ему.
model AuditLog {
  id          String      @id @default(cuid())
  entity      String // ORDER | CLIENT | USER | SHIFT_GROUP | SERVICE | TASK | CLEANER | REPORT | FINANCE | BONUS | PROPOSAL | CHECKLIST | REMINDER
  entityId    String
  entityTitle String // снапшот названия объекта
  action      AuditAction
  summary     String? // человеческая фраза, напр. «Обработка → Оплачено»
  /// [{ field, label, before, after }] — что именно поменялось
  changes     Json?
  actorId     String?
  actorName   String // снапшот ФИО
  ip          String?
  createdAt   DateTime    @default(now())

  @@index([entity, entityId, createdAt]) // история по объекту
  @@index([actorId, createdAt]) // что делал сотрудник
  @@index([createdAt]) // общая лента
}

// ═══════════════════════════════════════════════════════════
//  ТЗ 7 — Финансовый учёт
// ═══════════════════════════════════════════════════════════

/// Банк или платёжный сервис (ТЗ 3.1).
///
/// Справочник, а не перечисление в коде: завтра компания начнёт принимать
/// переводы через Эсхату — руководитель заведёт её сам, как заводит услугу.
model PaymentBank {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  /// Базовые записи (Алиф, Душанбе Сити, «другой банк») — удалению не подлежат
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  payments       OrderPayment[]
  financeEntries FinanceEntry[]

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

/// Взнос клиента по заказу (ТЗ 3.1, 3.2).
///
/// Раньше оплата была одним числом в заказе: система знала СКОЛЬКО получено,
/// но не знала чем, когда и сколькими частями. Теперь каждый взнос — своя
/// строка, и «смешанная оплата» — это просто несколько строк с разными
/// способами, а не отдельная сущность.
model OrderPayment {
  id      String         @id @default(cuid())
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String
  amount  Int
  /// Пусто только у записей, перенесённых из прежнего учёта: тогда способ
  /// оплаты не спрашивали, и придумывать его задним числом нельзя
  method  PaymentMethod?
  bank    PaymentBank?   @relation(fields: [bankId], references: [id], onDelete: SetNull)
  bankId  String?
  /// Уточнение: номер перевода, «другой банк — Эсхата» и подобное
  note    String?
  /// Когда деньги фактически получены — по этой дате взнос попадает в доходы
  paidAt  DateTime       @default(now())

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([orderId])
  @@index([paidAt])
  @@index([deletedAt])
}

/// Единая книга доходов и расходов компании (ТЗ 7.1)
model FinanceEntry {
  id       String          @id @default(cuid())
  kind     FinanceKind
  category FinanceCategory @default(OTHER_INCOME)
  amount   Int // сомони, целое
  date     DateTime // день операции (полночь по Душанбе, приведённая к UTC)
  title    String
  comment  String?
  source   FinanceSource   @default(MANUAL)

  /// Ключ идемпотентности автоматических записей, напр. order:<id>:income,
  /// report:<id>:labor, bonus:<id>. У ручных записей NULL — в Postgres
  /// NULL не конфликтует в UNIQUE, поэтому один индекс закрывает всё.
  autoKey String? @unique

  order        Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId      String?
  clientId     String?
  shiftGroupId String?
  reportId     String?
  bonusId      String?

  /// Чем получены деньги (ТЗ 3.1): наличные или банк. У расходов и старых
  /// записей пусто — способ тогда не спрашивали.
  paymentMethod PaymentMethod?
  /// Конкретный банк из справочника — по нему сводят поступления
  bank          PaymentBank?   @relation(fields: [bankId], references: [id], onDelete: SetNull)
  bankId        String?

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([kind, date])
  @@index([category, date])
  @@index([orderId])
  @@index([bankId])
  @@index([deletedAt])
}

/// Премия сотруднику — только ручное начисление (ТЗ 7.2)
model Bonus {
  id            String    @id @default(cuid())
  cleaner       Cleaner?  @relation(fields: [cleanerId], references: [id], onDelete: SetNull)
  cleanerId     String?
  userId        String? // сотрудник CRM (снапшот-ссылка)
  recipientName String // снапшот ФИО получателя
  amount        Int
  reason        String // за что начислена
  periodFrom    DateTime?
  periodTo      DateTime?
  createdById   String // кто начислил
  createdByName String
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ── Корзина (ТЗ 6) ──
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([cleanerId])
  @@index([userId])
  @@index([createdAt])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════
//  ТЗ 8 — Чек-листы контроля качества
// ═══════════════════════════════════════════════════════════

/// Шаблон чек-листа (обычно свой на каждый вид уборки)
/// Оценка загрязнения при приёме объекта — как в бумажном чек-листе
enum DirtAssessment {
  NORMAL // норма / лёгкое
  MEDIUM // среднее загрязнение
  HEAVY // сильное / критичное
}

model ChecklistTemplate {
  id           String                  @id @default(cuid())
  name         String
  /// Пункты оцениваются по шкале «норма / среднее / сильное» — это чек-лист
  /// приёма объекта. false — обычная проверка качества с галочкой.
  usesLevels   Boolean                 @default(false)
  /// Пояснение к назначению чек-листа («Приём объекта до начала работ»)
  description  String?
  cleaningType CleaningType? // null — подходит любому виду уборки
  serviceKey   String? // ключ услуги из Tariff.key
  isActive     Boolean                 @default(true)
  items        ChecklistTemplateItem[]
  createdById  String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([cleaningType])
  @@index([deletedAt])
}

model ChecklistTemplateItem {
  id         String            @id @default(cuid())
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  title      String
  /// Подсказка мелким шрифтом: на что смотреть и почему это важно
  hint       String?
  section    String? // «Кухня», «Санузел», «Комнаты»
  required   Boolean           @default(false)
  sortOrder  Int               @default(0)

  @@index([templateId])
}

/// Чек-лист конкретного заказа — снапшот пунктов шаблона на момент применения.
/// Правка шаблона задним числом не меняет уже выданные чек-листы.
model OrderChecklist {
  id           String               @id @default(cuid())
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String               @unique
  templateId   String?
  templateName String
  /// Копия признака из шаблона: чек-лист приёма оценивается по шкале
  usesLevels   Boolean              @default(false)
  /// «Комментарии и особые отметки» — свободное поле внизу бумажной формы
  note         String?
  status       ChecklistStatus      @default(OPEN)
  completedAt  DateTime?
  items        OrderChecklistItem[]
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model OrderChecklistItem {
  id          String          @id @default(cuid())
  checklist   OrderChecklist  @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  checklistId String
  title       String
  hint        String?
  section     String?
  required    Boolean         @default(false)
  sortOrder   Int             @default(0)
  isDone      Boolean         @default(false)
  /// Оценка загрязнения по пункту (только для чек-листов приёма объекта)
  level       DirtAssessment?
  /// Отмечает менеджер или бригадир со своего аккаунта в CRM
  doneById    String?
  doneByName  String?
  doneAt      DateTime?
  comment     String?

  @@index([checklistId])
}

// ═══════════════════════════════════════════════════════════
//  ТЗ 9 — Коммерческие предложения
// ═══════════════════════════════════════════════════════════

/// Шаблон КП. В тексте доступны подстановки вида {{client}}, {{phone}},
/// {{address}}, {{area}}, {{pricePerSqm}}, {{total}}, {{manager}}, {{date}}, {{items}}
model ProposalTemplate {
  id         String     @id @default(cuid())
  name       String
  intro      String?
  body       String
  conditions String?
  validDays  Int        @default(7)
  isDefault  Boolean    @default(false)
  isActive   Boolean    @default(true)
  proposals  Proposal[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([deletedAt])
}

/// Отправленное КП. Данные клиента и заказа — снапшоты: предложение не должно
/// меняться задним числом, если потом поправят клиента или заказ.
model Proposal {
  id     String         @id @default(cuid())
  number Int            @default(autoincrement()) // человекочитаемый номер
  status ProposalStatus @default(DRAFT)

  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  order      Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    String?
  template   ProposalTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId String?

  templateName String
  clientName   String
  clientPhone  String?
  address      String?
  area         Int?
  pricePerSqm  Int?
  total        Int     @default(0)
  discount     Int     @default(0)
  /// [{ title, volume, unitPrice, amount }]
  items        Json?
  bodySnapshot String

  validUntil DateTime?

  /// ТЗ 9.2 — кто отправил КП клиенту
  sentById   String?
  sentByName String?
  sentAt     DateTime?

  createdById   String
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([clientId, sentAt])
  @@index([orderId])
  @@index([status])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════
//  ТЗ 10 — Напоминания и Telegram
// ═══════════════════════════════════════════════════════════

/// Напоминание перезвонить клиенту, в том числе из предзаказа (ТЗ 10.1)
model Reminder {
  id       String  @id @default(cuid())
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  order    Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId  String?

  title    String
  note     String?
  remindAt DateTime

  status ReminderStatus @default(PENDING)
  source ReminderSource @default(MANUAL)

  assigneeId   String // кому напомнить (User.id)
  assigneeName String

  createdById   String
  createdByName String

  sentAt        DateTime?
  /// Когда предупредили за час до срока — чтобы не слать это дважды
  preNotifiedAt DateTime?
  doneAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  @@index([status, remindAt]) // что пора отправить
  @@index([assigneeId, status]) // «мои напоминания»
  @@index([clientId])
  @@index([deletedAt])
}

/// Очередь исходящих сообщений Telegram.
/// Отправка вынесена в очередь, чтобы таймаут Telegram не ронял бизнес-операцию,
/// а перезапуск контейнера при деплое не терял уведомления.
model TelegramMessage {
  id        String         @id @default(cuid())
  chatId    String
  text      String
  parseMode String?        @default("HTML")
  status    TelegramStatus @default(PENDING)
  attempts  Int            @default(0)
  lastError String?
  nextTryAt DateTime       @default(now())
  sentAt    DateTime?
  kind      String? // lead | order_preferences | reminder | proposal | shift_closed
  refId     String?
  createdAt DateTime       @default(now())

  @@index([status, nextTryAt])
}
